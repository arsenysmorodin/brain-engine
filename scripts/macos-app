#!/bin/sh
set -eu
task_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$task_root"
if command -v cargo >/dev/null 2>&1; then
    cargo build -p neuro-app --locked --offline
else
    ./scripts/cargo-local build -p neuro-app --locked --offline
fi
task_bundle="$task_root/output/NeuroLab.app/Contents"
mkdir -p "$task_bundle/MacOS" "$task_bundle/Resources/licenses"
cp target/debug/neuro-app "$task_bundle/MacOS/NeuroLab"
cp assets/fonts/OFL.txt "$task_bundle/Resources/licenses/NotoSans-OFL.txt"
cp assets/fonts/NotoSansMath-OFL.txt "$task_bundle/Resources/licenses/NotoSansMath-OFL.txt"
cp assets/fonts/NotoSansSymbols2-OFL.txt "$task_bundle/Resources/licenses/NotoSansSymbols2-OFL.txt"
cp LICENSE "$task_bundle/Resources/licenses/NeuroLab-MIT.txt"
cp data/operational-model.json "$task_bundle/Resources/licenses/Operational-model-provenance.json"
cp data/purine-model.json "$task_bundle/Resources/licenses/Purine-model-provenance.json"
cp data/perfusion-model.json "$task_bundle/Resources/licenses/Perfusion-model-provenance.json"
cp data/vascular-atlas.json "$task_bundle/Resources/licenses/Vascular-atlas-provenance.json"
cp data/caffeine-model.json "$task_bundle/Resources/licenses/Caffeine-model-provenance.json"
cp data/population-model.json "$task_bundle/Resources/licenses/Population-model-provenance.json"
cp assets/brain/LICENSE-BodyParts3D.txt "$task_bundle/Resources/licenses/BodyParts3D-CC-BY-4.0.txt"
cat > "$task_bundle/Info.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleExecutable</key><string>NeuroLab</string>
<key>CFBundleIdentifier</key><string>local.neurolab.desktop</string>
<key>CFBundleName</key><string>NeuroLab</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleShortVersionString</key><string>0.1.0</string>
<key>CFBundleVersion</key><string>1</string>
<key>LSMinimumSystemVersion</key><string>13.0</string>
<key>NSHighResolutionCapable</key><true/>
</dict></plist>
PLIST
plutil -lint "$task_bundle/Info.plist"
codesign --force --deep --sign - "$task_root/output/NeuroLab.app"
printf '%s\n' "Готово: $task_root/output/NeuroLab.app"
